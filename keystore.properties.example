# Copy this file to keystore.properties (in the project root) and fill in your
# keystore details to produce a signed release APK.
# keystore.properties is listed in .gitignore so your credentials stay private.
#
# Generate a new keystore with:
#   keytool -genkeypair -v -keystore my-release-key.jks \
#           -alias my-key-alias -keyalg RSA -keysize 2048 -validity 10000

storeFile=../my-release-key.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
